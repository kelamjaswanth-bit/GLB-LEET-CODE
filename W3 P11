class Solution {
    public boolean predictTheWinner(int[] nums) {
        int n = nums.length;
        // dp[j] represents the maximum score difference (current player - opponent)
        // for the subarray ending at index j
        int[] dp = new int[n];
        
        for (int i = n - 1; i >= 0; i--) {
            dp[i] = nums[i];
            for (int j = i + 1; j < n; j++) {
                // Current player chooses either nums[i] or nums[j], 
                // subtracting the optimal score difference the opponent will get next
                int pickLeft = nums[i] - dp[j];
                int pickRight = nums[j] - dp[j - 1];
                dp[j] = Math.max(pickLeft, pickRight);
            }
        }
        
        // If Player 1's net score advantage is >= 0, Player 1 wins or ties
        return dp[n - 1] >= 0;
    }
}
