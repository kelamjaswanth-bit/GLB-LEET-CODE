class Solution {
    private static final int MOD = 1337;

    public int superPow(int a, int[] b) {
        int result = 1;
        a %= MOD; // Prevent overflow on initial multiplications

        for (int digit : b) {
            result = (modPow(result, 10) * modPow(a, digit)) % MOD;
        }

        return result;
    }

    // Helper method to compute (base^exp) % MOD in O(log(exp)) time
    private int modPow(int base, int exp) {
        int res = 1;
        base %= MOD;
        
        while (exp > 0) {
            if ((exp & 1) == 1) {
                res = (res * base) % MOD;
            }
            base = (base * base) % MOD;
            exp >>= 1;
        }
        
        return res;
    }
}
