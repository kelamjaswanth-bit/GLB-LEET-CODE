class Solution {
    public int kthGrammar(int n, int k) {
        // Base case: the 1st row only has '0'
        if (n == 1) {
            return 0;
        }
        
        // Calculate the length of the previous row (2^(n-2))
        int mid = 1 << (n - 2);
        
        if (k <= mid) {
            // First half of row n is identical to row n-1
            return kthGrammar(n - 1, k);
        } else {
            // Second half of row n is the bitwise complement of row n-1
            return 1 - kthGrammar(n - 1, k - mid);
        }
    }
}
