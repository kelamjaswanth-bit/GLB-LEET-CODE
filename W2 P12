class Solution {
    public int divide(int dividend, int divisor) {
        // Handle the only 32-bit signed integer overflow case: -2^31 / -1 = 2^31
        if (dividend == Integer.MIN_VALUE && divisor == -1) {
            return Integer.MAX_VALUE;
        }

        // Determine if the final quotient should be negative
        boolean isNegative = (dividend < 0) ^ (divisor < 0);

        // Work with negative numbers to avoid overflow when converting Integer.MIN_VALUE (-2^31)
        int a = dividend > 0 ? -dividend : dividend;
        int b = divisor > 0 ? -divisor : divisor;

        int quotient = 0;

        while (a <= b) {
            int currentDivisor = b;
            int count = 1;

            // Double currentDivisor until it's smaller than half of 'a' (to prevent overflow)
            while (currentDivisor >= (Integer.MIN_VALUE >> 1) && a <= (currentDivisor << 1)) {
                currentDivisor <<= 1;
                count <<= 1;
            }

            a -= currentDivisor;
            quotient += count;
        }

        return isNegative ? -quotient : quotient;
    }
}
