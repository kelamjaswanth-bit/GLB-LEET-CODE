class Solution {
    public int countDigitOne(int n) {
        int count = 0;
        
        // Iterate through each digit place (1s, 10s, 100s, etc.)
        // Use long for 'i' to prevent integer overflow when n is close to 10^9
        for (long i = 1; i <= n; i *= 10) {
            long divider = i * 10;
            
            // Calculate full cycles of '1' at the current place value
            count += (n / divider) * i;
            
            // Add remaining '1's in the incomplete cycle
            long remainder = n % divider;
            count += Math.min(Math.max(remainder - i + 1, 0L), i);
        }
        
        return count;
    }
}
