class Solution {
    public int integerReplacement(int n) {
        long num = n; // Use long to prevent overflow when n = Integer.MAX_VALUE
        int steps = 0;

        while (num > 1) {
            if ((num & 1) == 0) {
                // If even, divide by 2
                num >>= 1;
            } else {
                // If odd, choose +1 or -1 based on trailing bits
                // Special case: 3 should become 2 (3 -> 2 -> 1 is faster than 3 -> 4 -> 2 -> 1)
                if (num == 3 || ((num >> 1) & 1) == 0) {
                    num--;
                } else {
                    num++;
                }
            }
            steps++;
        }

        return steps;
    }
}
